NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública onde o site roda — usada por scripts/convidar-usuario.mjs para
# montar o link de convite. Em produção: https://sigiloteca.com.br
NEXT_PUBLIC_SITE_URL=

# Só para scripts administrativos locais (ex: scripts/convidar-usuario.mjs).
# NUNCA usar no código do app nem expor ao cliente — dá acesso total ao
# projeto, ignorando RLS. Fica em Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Aviso por e-mail ao escritório quando chega uma solicitação de titular
# (LGPD). Mesma caixa de e-mail da Hostinger usada no SMTP do Supabase.
# Sem essas variáveis o app funciona normalmente, só não envia o aviso.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Quem recebe o aviso (vários endereços separados por vírgula)
AVISO_TITULARES_PARA=
